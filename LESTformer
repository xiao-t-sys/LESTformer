import torch.nn as nn
import torch
import math
import numpy as np
from torchinfo import summary
from model.startconv import Star_Block_4D  
from model.LA import LocalAttention_4D

class AttentionLayer(nn.Module):
    def __init__(self, model_dim, num_heads=8, mask=False):
        super().__init__()
        self.model_dim = model_dim
        self.num_heads = num_heads
        self.mask = mask
        self.head_dim = model_dim // num_heads

        self.FC_Q = nn.Linear(model_dim, model_dim)
        self.FC_K = nn.Linear(model_dim, model_dim)
        self.FC_V = nn.Linear(model_dim, model_dim)
        self.out_proj = nn.Linear(model_dim, model_dim)

    def forward(self, query, key, value):
        batch_size = query.shape[0]
        tgt_length = query.shape[-2]
        src_length = key.shape[-2]

        query = self.FC_Q(query)
        key = self.FC_K(key)
        value = self.FC_V(value)

        query = torch.cat(torch.split(query, self.head_dim, dim=-1), dim=0)
        key = torch.cat(torch.split(key, self.head_dim, dim=-1), dim=0)
        value = torch.cat(torch.split(value, self.head_dim, dim=-1), dim=0)

        key = key.transpose(-1, -2)
        attn_score = (query @ key) / self.head_dim ** 0.5

        if self.mask:
            mask = torch.ones(tgt_length, src_length, dtype=torch.bool, device=query.device).tril()
            attn_score.masked_fill_(~mask, -torch.inf)

        attn_score = torch.softmax(attn_score, dim=-1)
        out = attn_score @ value
        out = torch.cat(torch.split(out, batch_size, dim=0), dim=-1)
        out = self.out_proj(out)
        return out

class PreNorm(nn.Module):
    def __init__(self, dim, fn):
        super().__init__()
        self.norm = nn.LayerNorm(dim)
        self.fn = fn

    def forward(self, x, **kwargs):
        return self.fn(self.norm(x), **kwargs)

class FeedForward(nn.Module):
    def __init__(self, dim, hidden_dim, dropout=0.):
        super().__init__()
        self.net = nn.Sequential(
            nn.Linear(dim, hidden_dim),
            nn.GELU(),
            nn.Dropout(dropout),
            nn.Linear(hidden_dim, dim),
            nn.Dropout(dropout)
        )

    def forward(self, x):
        return self.net(x)

class Temporal_Attention(nn.Module):
    def __init__(self, dim, heads=2, window_size=12, qkv_bias=False, qk_scale=None, dropout=0., causal=True):
        super().__init__()
        assert dim % heads == 0, f"dim {dim} should be divided by num_heads {heads}."
        self.dim = dim
        self.num_heads = heads
        self.causal = causal
        head_dim = dim // heads
        self.scale = qk_scale or head_dim ** -0.5
        self.window_size = window_size

        self.qkv = nn.Linear(dim, dim * 3, bias=qkv_bias)
        self.attn_drop = nn.Dropout(dropout)
        self.proj = nn.Linear(dim, dim)
        self.proj_drop = nn.Dropout(dropout)

        if window_size > 0:
            self.register_buffer('mask', torch.tril(torch.ones(window_size, window_size)))
        else:
            self.mask = None

    def forward(self, x):
        B_prev, T_prev, C_prev = x.shape
        if self.window_size > 0:
            assert T_prev % self.window_size == 0, "Time steps must be divisible by window size"
            x = x.reshape(-1, self.window_size, C_prev)
        B, T, C = x.shape

        qkv = self.qkv(x).reshape(B, -1, 3, self.num_heads, C // self.num_heads).permute(2, 0, 3, 1, 4)
        q, k, v = qkv[0], qkv[1], qkv[2]

        attn = (q @ k.transpose(-2, -1)) * self.scale

        if self.causal and self.mask is not None:
            attn = attn.masked_fill_(self.mask == 0, float("-inf"))

        x = (attn.softmax(dim=-1) @ v).transpose(1, 2).reshape(B, T, C)
        x = self.proj(x)
        x = self.proj_drop(x)

        if self.window_size > 0:  
            x = x.reshape(B_prev, T_prev, C_prev)
        return x

class Temporal_block(nn.Module):
    def __init__(self, dim=128, depth=2, heads=2, window_size=12, mlp_dim=64, num_time=12, dropout=0.):
        super().__init__()
        self.pos_embedding = nn.Parameter(torch.randn(1, num_time, dim))
        self.layers = nn.ModuleList([])

        for i in range(depth):
            self.layers.append(nn.ModuleList([
                Temporal_Attention(dim=dim, heads=heads, window_size=window_size, dropout=dropout),
                PreNorm(dim, FeedForward(dim, mlp_dim, dropout=dropout))
            ]))

    def forward(self, x):
        b, c, n, t = x.shape
        x = x.permute(0, 2, 3, 1).reshape(b * n, t, c)  
        x = x + self.pos_embedding

        for attn, ff in self.layers:
            x = attn(x) + x
            x = ff(x) + x  

        x = x.reshape(b, n, t, c).permute(0, 3, 1, 2)  
        return x

class LocalEnhancedSelfAttentionLayer(nn.Module):
    def __init__(self, model_dim, feed_forward_dim=2048, num_heads=8, dropout=0):
        super().__init__()
        self.model_dim = model_dim
        self.attn = AttentionLayer(model_dim, num_heads, mask=False)
        
        self.feed_forward = nn.Sequential(
            nn.Linear(model_dim, feed_forward_dim),
            nn.ReLU(inplace=True),
            nn.Linear(feed_forward_dim, model_dim),
        )
        self.ln1 = nn.LayerNorm(model_dim)
        self.ln2 = nn.LayerNorm(model_dim)
        self.dropout1 = nn.Dropout(dropout)
        self.dropout2 = nn.Dropout(dropout)
        
        self.local_attention = LocalAttention_4D(
            channels=model_dim,
            f=max(8, model_dim // 4),
            use_adaptive_pooling=True,
            interpolate_method='linear'
        )
        
        self.fusion_gate = nn.Sequential(
            nn.Linear(model_dim * 2, model_dim),
            nn.GELU(),
            nn.Linear(model_dim, model_dim),
            nn.Sigmoid()
        )

    def forward(self, x, dim=-2):
        x = x.transpose(dim, -2)  

        local_enhanced = self.local_attention(x)  

        residual = x
        spatial_out = self.attn(x, x, x)
        spatial_out = self.dropout1(spatial_out)
        spatial_out = self.ln1(residual + spatial_out)

        concat_features = torch.cat([local_enhanced, spatial_out], dim=-1)  
        fusion_weights = self.fusion_gate(concat_features)  
        
        fused_out = fusion_weights * local_enhanced + (1 - fusion_weights) * spatial_out

        residual = fused_out
        out = self.feed_forward(fused_out)
        out = self.dropout2(out)
        out = self.ln2(residual + out)

        return out.transpose(dim, -2)


class LESTformer(nn.Module):
    def __init__(
            self,
            num_nodes,
            in_steps=12,
            out_steps=12,
            steps_per_day=288,
            input_dim=3,
            output_dim=1,
            input_embedding_dim=24,
            tod_embedding_dim=24,
            dow_embedding_dim=24,
            spatial_embedding_dim=0,
            adaptive_embedding_dim=80,
            feed_forward_dim=256,
            num_heads=4,
            num_layers=3,
            dropout=0.1,
            use_mixed_proj=True,
            temporal_depth=2,
            temporal_heads=2,
            window_size=12,
            use_star_enhancement=True,
            star_mlp_ratio=3,
            star_conv_mode='mixed',
            device='cuda:0',
    ):
        super().__init__()
        self.num_nodes = num_nodes
        self.in_steps = in_steps
        self.out_steps = out_steps
        self.steps_per_day = steps_per_day
        self.input_dim = input_dim
        self.output_dim = output_dim
        self.input_embedding_dim = input_embedding_dim
        self.tod_embedding_dim = tod_embedding_dim
        self.dow_embedding_dim = dow_embedding_dim
        self.spatial_embedding_dim = spatial_embedding_dim
        self.adaptive_embedding_dim = adaptive_embedding_dim
        self.feed_forward_dim = feed_forward_dim
        self.num_heads = num_heads
        self.num_layers = num_layers
        self.dropout = dropout
        self.use_mixed_proj = use_mixed_proj
        self.device = device
        self.temporal_depth = temporal_depth
        self.temporal_heads = temporal_heads
        self.window_size = window_size
        self.use_star_enhancement = use_star_enhancement

        self.model_dim = (
                input_embedding_dim
                + tod_embedding_dim
                + dow_embedding_dim
                + spatial_embedding_dim
                + adaptive_embedding_dim
        )

        self.feature_conv = nn.Conv2d(
            in_channels=input_dim, 
            out_channels=input_embedding_dim, 
            kernel_size=(1, 3), 
            padding=(0, 1)
        )

        if tod_embedding_dim > 0:
            self.tod_embedding = nn.Embedding(steps_per_day, tod_embedding_dim)

        if dow_embedding_dim > 0:
            self.dow_embedding = nn.Embedding(7, dow_embedding_dim)

        if spatial_embedding_dim > 0:
            self.node_emb = nn.Parameter(torch.empty(self.num_nodes, self.spatial_embedding_dim))
            nn.init.xavier_uniform_(self.node_emb)

        if adaptive_embedding_dim > 0:
            self.adaptive_embedding = nn.init.xavier_uniform_(
                nn.Parameter(torch.empty(in_steps, num_nodes, adaptive_embedding_dim))
            )

        if self.temporal_depth > 0:
            self.temporal_block = Temporal_block(
                dim=self.model_dim,
                depth=temporal_depth,
                heads=temporal_heads,
                window_size=window_size,
                mlp_dim=feed_forward_dim,
                num_time=in_steps,
                dropout=dropout
            )

        self.attn_layers_s = nn.ModuleList([
            LocalEnhancedSelfAttentionLayer(
                model_dim=self.model_dim,
                feed_forward_dim=feed_forward_dim,
                num_heads=num_heads,
                dropout=dropout
            )
            for _ in range(num_layers)
        ])

        if self.use_star_enhancement:
            self.star_enhancement = Star_Block_4D(
                dim=self.model_dim,
                mlp_ratio=star_mlp_ratio,
                drop_path=dropout,
                conv_mode=star_conv_mode
            )

        if use_mixed_proj:
            self.output_proj = nn.Linear(self.model_dim, out_steps * output_dim)
        else:
            self.temporal_proj = nn.Linear(1, out_steps)
            self.output_proj = nn.Linear(self.model_dim, self.output_dim)

    def forward(self, x):
        batch_size = x.shape[0]
        features = []

        if self.tod_embedding_dim > 0:
            tod_emb = self.tod_embedding((x[..., 1] * self.steps_per_day).long())
            features.append(tod_emb)

        if self.dow_embedding_dim > 0:
            dow_emb = self.dow_embedding((x[..., 2]).long())
            features.append(dow_emb)

        if self.spatial_embedding_dim > 0:
            spatial_emb = self.node_emb.expand(batch_size, self.in_steps, *self.node_emb.shape)
            features.append(spatial_emb)

        if self.adaptive_embedding_dim > 0:
            adp_emb = self.adaptive_embedding.expand(size=(batch_size, *self.adaptive_embedding.shape))
            features.append(adp_emb)

        main_input = x[..., :self.input_dim].permute(0, 3, 2, 1)  
        x_conv = self.feature_conv(main_input)  
        x_conv = x_conv.permute(0, 3, 2, 1)  

        if features:
            x_embedded = torch.cat(features, dim=-1)
            x_fused = torch.cat([x_conv, x_embedded], dim=-1)
        else:
            x_fused = x_conv

        if self.temporal_depth > 0:
            x_fused_permute = x_fused.permute(0, 3, 2, 1)  
            x_temporal = self.temporal_block(x_fused_permute)  
            x_temporal = x_temporal.permute(0, 3, 2, 1)  
        else:
            x_temporal = x_fused

        for enhanced_attn in self.attn_layers_s:
            x_temporal = enhanced_attn(x_temporal, dim=2)

        if self.use_star_enhancement:
            x_star = self.star_enhancement(x_temporal)
            x_last = x_star[:, -1:, :, :]
        else:
            x_last = x_temporal[:, -1:, :, :]

        if self.use_mixed_proj:
            x_last = x_last.squeeze(1)  
            out = self.output_proj(x_last).view(
                batch_size, self.num_nodes, self.out_steps, self.output_dim
            )
            out = out.transpose(1, 2)  
        else:
            x_last = x_last.transpose(1, 3)
            out = self.temporal_proj(x_last)
            out = self.output_proj(out.transpose(1, 3))

        return out

    def get_model_info(self):
        total_params = sum(p.numel() for p in self.parameters())
        trainable_params = sum(p.numel() for p in self.parameters() if p.requires_grad)
        info = {
            'model_name': 'LESTformer',
            'total_params': total_params,
            'trainable_params': trainable_params,
            'model_dim': self.model_dim,
            'num_layers': self.num_layers,
            'use_star_enhancement': self.use_star_enhancement,
        }
        return info
